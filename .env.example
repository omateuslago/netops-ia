NETOPS_ENVIRONMENT=development
NETOPS_API_V1_PREFIX=/api/v1
NETOPS_KNOWLEDGE_DIR=knowledge
NETOPS_DATA_DIR=data
NETOPS_MODEL_CACHE_DIR=data/models

# Limites da prévia de PDF (bytes, páginas e caracteres extraídos)
NETOPS_MAX_UPLOAD_BYTES=10485760
NETOPS_MAX_PDF_PAGES=100
NETOPS_MAX_EXTRACTED_CHARS=250000
# Tamanhos em caracteres, não tokens
NETOPS_CHUNK_SIZE=900
NETOPS_CHUNK_OVERLAP=150
# v2 preserva frases quando cabem. Use uma NOVA pasta de dados para experimentar.
NETOPS_TOKEN_PIPELINE=pdf-token-v1

# Embeddings em CPU: o modelo e sua revisão ficam fixados no adaptador.
NETOPS_EMBEDDING_THREADS=2
NETOPS_EMBEDDING_BATCH_SIZE=8
NETOPS_MAX_INDEX_CHUNKS=2000
# Após o primeiro download, true impede consultas/downloads no Hugging Face.
NETOPS_MODEL_LOCAL_FILES_ONLY=false

# Nome exato de um modelo instalado no Ollama local (127.0.0.1:11434).
# Vazio retorna erro explícito em /answer quando há candidatos.
NETOPS_OLLAMA_MODEL=

